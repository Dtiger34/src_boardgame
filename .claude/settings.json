{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "vietnamese",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(DROP TABLE *)",
      "Bash(truncate *)"
    ],
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(tsc *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(cat *)"
    ]
  }
}
